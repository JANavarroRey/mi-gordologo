# Clave gratuita de Google AI Studio: https://aistudio.google.com/apikey
# Opcional: la app funciona sin ella (motor offline).
# NUNCA subas la clave real a GitHub. En producción usa Perfil → pegar clave
# o un secret de GitHub Actions (queda visible en el JS público: mejor localStorage).
VITE_GEMINI_API_KEY=

# Supabase Free (opcional) — guardar menús/usuarios entre móviles
# 1) https://supabase.com → proyecto gratis
# 2) SQL Editor → ejecuta supabase/schema.sql
# 3) Project Settings → API → URL y anon key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
